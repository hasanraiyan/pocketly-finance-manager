PORT=4000
MONGODB_URI=mongodb://localhost:27017/pocketly
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://pocketly.hasanraiyan.me
SENTRY_DSN=

# Auth — self-hosted (apps/api/src/auth/, apps/api/src/mcp/oauth/). No keys
# to configure: the RS256 signing keypair for every issued JWT (session
# tokens and MCP OAuth tokens alike) is generated on first boot and
# persisted in Mongo (`auth_signing_keys`) -- see JwtKeysService.
#
# Comma-separated emails that get the `admin` role on registration.
ADMIN_EMAILS=


# Redis — required by BullMQ (export job queue).
# Local dev: `pnpm docker:up` (see docker-compose.yml) starts one on
# localhost:6379, no password, no TLS -- leave REDIS_TLS unset for it.
# Hosted (e.g. Upstash's 256MB free tier -- redis.io's own Redis Cloud is
# only 30MB free): copy the host/port/password from their console and set
# REDIS_TLS=true, which hosted providers require.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=

# Resend — sends the exported PDF report by email.
# Get a key at https://resend.com/api-keys. Leave empty to run with export
# email sending disabled (the job still queues and renders, it just logs
# a warning and skips the send instead of failing).
RESEND_API_KEY=
# Must be on a domain verified in Resend, or leave as the default sandbox
# sender (works without verifying anything, but only delivers to the email
# address on your own Resend account until you verify a domain).
RESEND_FROM_EMAIL="Pocketly <onboarding@resend.dev>"

# Firebase Cloud Messaging (FCM) — Push notifications for Web & Android
# Get these credentials from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or provide the full raw service account JSON string:
FIREBASE_SERVICE_ACCOUNT_JSON=

# Persona AI Copilot (persona.hasanraiyan.me)
# Get credential from Persona Developer Studio -> Projects -> Mint Credential
PERSONA_BASE_URL=https://api.persona.hasanraiyan.me
PERSONA_CREDENTIAL=
PERSONA_DEFAULT_AGENT_ID=6a83ea6bb3d55db9792763a6
