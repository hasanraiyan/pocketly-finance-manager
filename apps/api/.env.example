PORT=4000
MONGODB_URI=mongodb://localhost:27017/pocketly
BETTER_AUTH_SECRET=
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SENTRY_DSN=

# Redis — required by BullMQ (export job queue)
# Locally: docker run -p 6379:6379 redis:alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Resend — sends the exported PDF report by email.
# Get a key at https://resend.com/api-keys. Leave empty to run with export
# email sending disabled (the job still queues and renders, it just logs
# a warning and skips the send instead of failing).
RESEND_API_KEY=
# Must be on a domain verified in Resend, or leave as the default sandbox
# sender (works without verifying anything, but only delivers to the email
# address on your own Resend account until you verify a domain).
RESEND_FROM_EMAIL="Pocketly <onboarding@resend.dev>"
