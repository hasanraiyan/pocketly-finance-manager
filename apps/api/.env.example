PORT=4000
MONGODB_URI=mongodb://localhost:27017/pocketly
BETTER_AUTH_SECRET=
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SENTRY_DSN=

# Redis — required by BullMQ (export job queue)
# Locally: docker run -p 6379:6379 redis:alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP — Nodemailer (sends the exported PDF via email)
# Use Gmail App Password, or Resend SMTP (smtp.resend.com / port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pocketly <noreply@pocketly.app>"
