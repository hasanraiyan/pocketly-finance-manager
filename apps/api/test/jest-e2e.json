{
  "moduleFileExtensions": ["js", "json", "ts", "tsx", "mjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest",
    "^.+\\.mjs$": "ts-jest"
  },
  "transformIgnorePatterns": [],
  "moduleNameMapper": {
    "^@react-pdf/renderer$": "<rootDir>/mocks/react-pdf-renderer.js"
  }
}
