{
  "expo": {
    "name": "Pocketly",
    "slug": "pocketly",
    "scheme": "pocketly",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hasanraiyan.pocketly"
    },
    "android": {
      "package": "com.hasanraiyan.pocketly",
      "adaptiveIcon": {
        "backgroundColor": "#193b24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-quick-actions",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickActionWidget",
              "label": "Pocketly Quick Add",
              "minWidth": "160dp",
              "minHeight": "60dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "description": "Log an expense or income with 1 tap from home screen",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "BalancePulseWidget",
              "label": "Pocketly Balance & Pulse",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "View live balance and quick actions",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f78b4db-4bd7-49de-a756-fb71b94a4aa5"
      }
    }
  }
}
