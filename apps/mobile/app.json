{
  "expo": {
    "name": "Pocketly",
    "slug": "pocketly",
    "scheme": "pocketly",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hasanraiyan.pocketly"
    },
    "android": {
      "package": "app.hasanraiyan.pocketly",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-quick-actions"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f78b4db-4bd7-49de-a756-fb71b94a4aa5"
      }
    }
  }
}
