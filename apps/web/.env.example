NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_AUTH_URL=http://localhost:4000/api/auth
# Public site origin, no trailing slash -- drives metadataBase, canonical
# URLs, robots.txt, and the sitemap. Set to the real production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry -- leave empty to run with monitoring disabled (default in dev).
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser bundle; SENTRY_DSN is
# server-only. Both come from the same Sentry project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed to upload source maps at build time (optional).
SENTRY_ORG=
SENTRY_PROJECT=
