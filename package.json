{
  "name": "pocketly",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev --filter=!mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "mongodb-memory-server"
    ]
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@types/cookie": "^1.0.0",
    "cookie": "^2.0.1",
    "jose": "^6.2.9"
  }
}
